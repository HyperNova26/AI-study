# FAST-LIO2 map, scan and trajectories next to wheel odometry and the simulator ground truth.
# Based on ../../preparation/rviz/sensors.rviz. Fixed frame odom: camera_init is tied to it
# by the static transform in launch/fast_lio_rviz.launch.py.
Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.58
  Tree Height: 460
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.33
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.4
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 12
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: true
    Name: RobotModel (wheel odometry pose)
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: false
      odom:
        Value: true
      camera_init:
        Value: true
      body:
        Value: true
      base_footprint:
        Value: true
    Marker Scale: 0.5
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: FAST-LIO2 map (Laser_map)
    Enabled: true
    Value: true
    Topic:
      Value: /Laser_map
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Style: Points
    Size (Pixels): 2
    Alpha: 0.8
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Use Fixed Frame: true
    Decay Time: 0.0
  - Class: rviz_default_plugins/PointCloud2
    Name: Current scan (cloud_registered)
    Enabled: true
    Value: true
    Topic:
      Value: /cloud_registered
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Style: Points
    Size (Pixels): 3
    Alpha: 1.0
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 255; 255; 255
    Use Fixed Frame: true
    Decay Time: 0.0
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 255; 140; 0
    Enabled: true
    Line Style: Billboards
    Line Width: 0.04
    Name: FAST-LIO2 path
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /path
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 120; 255
    Enabled: true
    Line Style: Billboards
    Line Width: 0.03
    Name: Wheel odometry path
    Offset:
      X: 0
      Y: 0
      Z: 0.01
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wheel_odom/path
    Value: true
  - Alpha: 0.8
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 200; 80
    Enabled: true
    Line Style: Billboards
    Line Width: 0.03
    Name: Ground truth path
    Offset:
      X: 0
      Y: 0
      Z: 0.02
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /ground_truth/path
    Value: true
  - Class: rviz_default_plugins/Odometry
    Name: FAST-LIO2 odometry
    Enabled: true
    Value: true
    Topic:
      Value: /Odometry
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Keep: 1
    Position Tolerance: 0.1
    Angle Tolerance: 0.3
    Shape:
      Value: Arrow
      Color: 255; 140; 0
      Alpha: 1
      Shaft Length: 0.35
      Shaft Radius: 0.025
      Head Length: 0.1
      Head Radius: 0.06
    Covariance:
      Value: false
  Enabled: true
  Global Options:
    Background Color: 40; 40; 44
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 8.5
      Pitch: 0.85
      Yaw: 4.4
      Focal Point:
        X: 2.0
        Y: 0.5
        Z: 0.0
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1600
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: true
  Views:
    collapsed: true
