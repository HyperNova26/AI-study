<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>livox_ros_driver2</name>
  <version>1.0.0</version>
  <description>
    Message definitions only (CustomMsg, CustomPoint) from Livox livox_ros_driver2.
    FAST_LIO includes these headers even for non-Livox input; this package lets it build
    without Livox-SDK2. It is not a LiDAR driver.
  </description>
  <maintainer email="noreply@hypernova.invalid">HyperNova AI study</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
